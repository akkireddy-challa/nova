# Nova configuration
# At least ONE LLM provider is required: set an API key below or run Ollama locally.
# Nova shows setup instructions instead of answering until a provider is configured.

# --- LLM providers ---

# Google Gemini API key (GOOGLE_API_KEY is also accepted)
GEMINI_API_KEY=
# Optional default Gemini model
GEMINI_MODEL=

# Anthropic Claude API key
ANTHROPIC_API_KEY=
# Optional default Claude model (default: claude-sonnet-5-5)
ANTHROPIC_MODEL=

# OpenAI API key, or the key for any OpenAI-compatible API
OPENAI_API_KEY=
# Optional base URL for OpenAI-compatible APIs, e.g. https://openrouter.ai/api/v1 or https://api.groq.com/openai/v1
OPENAI_BASE_URL=
# Optional default model for the OpenAI-compatible provider
OPENAI_MODEL=

# Ollama server URL; only used if reachable (use http://ollama:11434 with `docker compose --profile local`)
OLLAMA_BASE_URL=http://localhost:11434
# Optional default local Ollama model
OLLAMA_MODEL=

# --- Web search (optional) ---
# Providers are tried in order: Tavily, Brave, SearXNG, then DuckDuckGo HTML
# (keyless last resort that often blocks automated requests).

# Tavily search API key
TAVILY_API_KEY=
# Brave Search API key
BRAVE_API_KEY=
# Self-hosted SearXNG instance (recommended keyless option). Its settings must enable
# the json format (searxng/settings.yml does). Use http://localhost:8888 when running
# `docker compose --profile search up -d searxng` next to `bun dev`, or
# http://searxng:8080 when Nova also runs in Docker with `--profile search`.
SEARXNG_URL=
# Secret key for the bundled SearXNG service (generate with `openssl rand -hex 32`)
SEARXNG_SECRET=
