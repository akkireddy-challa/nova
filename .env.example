# Nova Environment Variables (Optional - runs offline with fallback simulation)

# Google Gemini API Key (Gemini 2.0 Flash / 1.5 Flash)
GEMINI_API_KEY=

# Anthropic Claude API Key (Optional)
ANTHROPIC_API_KEY=

# OpenAI API Key (Optional)
OPENAI_API_KEY=

# Local Ollama Host (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
